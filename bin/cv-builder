#!/usr/bin/env bash
# cv-builder for the Claude Code plugin: Claude Code puts this folder on the Bash tool's PATH while
# the plugin is enabled. Runs an installed cv-builder if there is one, else this plugin's own copy
# through uv, which builds it once into uv's cache.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IFS=: read -r -a dirs <<< "${PATH:-}"
for dir in "${dirs[@]}"; do
  [ -n "$dir" ] && [ "$(cd "$dir" 2>/dev/null && pwd)" != "$here" ] || continue
  if [ -x "$dir/cv-builder" ]; then exec "$dir/cv-builder" "$@"; fi
done
if command -v uvx >/dev/null 2>&1; then
  exec uvx --quiet --from "$here/.." cv-builder "$@"
fi
echo "cv-builder is not installed, and uv is not there to run it." >&2
echo "Install it with: uv tool install git+https://github.com/agusgonzaleznic/cv-builder" >&2
exit 127
